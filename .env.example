# ==============================================================================
# WireGuard VPN Gateway Environment Configuration
# ==============================================================================

# WireGuard Ports
WG_PORT=51820                     # UDP: Inbound WireGuard tunnel port
WG_UI_PORT=51821                  # TCP: Loopback Web UI (SSH tunnel only)

# Client Subnet & Routing
WG_SUBNET=10.8.0.0/24             # VPN Virtual IP Pool (.2 - .254)
WG_ALLOWED_IPS=0.0.0.0/0          # Full-tunnel: 0.0.0.0/0 routes 100% of traffic
WG_DNS=1.1.1.1, 9.9.9.9           # Upstream Encrypted DNS for clients

DISABLE_IPV6=true

# Initial First-Run Provisioning
# The script will auto-generate INIT_PASSWORD on first run
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PASSWORD=
INIT_HOST=79.132.143.211
